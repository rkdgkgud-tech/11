+    private fun seekRangeMs(): Long = settingsPrefs.getLong("seek_range_ms", 60_000L)
+
+    private fun showSeekSettings() {
+        val labels = arrayOf("5초", "10초", "30초", "1분", "5분")
+        val values = longArrayOf(5_000L, 10_000L, 30_000L, 60_000L, 300_000L)
+        val current = seekRangeMs()
+        val checked = values.indexOf(current).coerceAtLeast(3)
+        AlertDialog.Builder(this)
+            .setTitle("좌우 드래그 탐색 범위")
+            .setSingleChoiceItems(labels, checked) { dialog, which ->
+                settingsPrefs.edit().putLong("seek_range_ms", values[which]).apply()
+                flash("탐색 범위 ${labels[which]}")
+                dialog.dismiss()
+            }
+            .setNegativeButton("취소", null)
+            .show()
+    }
+
+    private fun scheduleSpeedHold(p: ExoPlayer) {
+        cancelSpeedHold(resetSpeed = false)
+        speedHolding = false
+        hold2x = Runnable {
+            speedHolding = true
+            p.setPlaybackSpeed(2f)
+            flash("2.0×")
+        }.also { holdHandler.postDelayed(it, 500) }
+        hold3x = Runnable {
+            if (speedHolding) {
+                p.setPlaybackSpeed(3f)
+                flash("3.0×")
+            }
+        }.also { holdHandler.postDelayed(it, 1500) }
+    }
+
+    private fun cancelSpeedHold(resetSpeed: Boolean) {
+        hold2x?.let { holdHandler.removeCallbacks(it) }
+        hold3x?.let { holdHandler.removeCallbacks(it) }
+        hold2x = null
+        hold3x = null
+        if (resetSpeed && speedHolding) player?.setPlaybackSpeed(1f)
+        speedHolding = false
+    }
